DATABASE_URL="postgresql://postgres:postgres@localhost:5435/billing?connection_limit=3"
PORT=3000
NODE_ENV="development"
ALLOWED_ORIGINS=
JWT_ALGORITHM="HS256"
JWT_SECRET="change-me-local-only"
JWT_PUBLIC_KEY=""
JWT_ISSUER="repo-auth-serverless"
JWT_AUDIENCE="async-furious-project"
JWT_EXPIRES_IN="1800"
KAFKA_BROKERS="localhost:9092"
KAFKA_SASL_USERNAME=""
KAFKA_SASL_PASSWORD=""
KAFKA_CONSUMER_GROUP="billing-service"
# Mercado Pago (Checkout Pro): cria a preference na aprovacao do orcamento.
MP_ACCESS_TOKEN=""
MP_NOTIFICATION_URL=""
# Chave que assina o webhook (painel do Mercado Pago > Webhooks); sem ela o webhook recusa tudo com 401.
MP_WEBHOOK_SECRET=""
# Prazo (horas) da preference: mesmo valor do detector de OS parada do OS Service (padrao 48 h; na demo, minutos).
MP_PREFERENCE_EXPIRACAO_HORAS="48"
# Seed so roda com DEPLOY_ENV=local ou hml.
DEPLOY_ENV="local"
